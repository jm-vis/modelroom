#!/bin/sh
# Public-repo guard: refuses a commit if any tracked file carries operator-specific content
# (machine paths, e-mail addresses, internal workspace vocabulary, key prefixes), then runs the
# secret scan over the staged content.
# Enable once per clone: git config core.hooksPath .githooks
top=$(git rev-parse --show-toplevel) || exit 1
cd "$top" || exit 1
uv run --frozen python tests/test_public_hygiene.py || {
    echo "pre-commit: public hygiene check failed, commit refused" >&2
    exit 1
}
uv run --frozen python scripts/gitleaks_gate.py pre-commit || {
    echo "pre-commit: secret scan failed, commit refused" >&2
    exit 1
}
