#!/bin/sh
# Second gate right before push: the same public hygiene check over the working tree, so a
# commit that slipped past pre-commit on another machine still cannot leave; then the secret
# scan over everything the push brings (content, merge results, messages, annotated tags).
# The push lines on stdin are kept in a file because two commands read them.
top=$(git rev-parse --show-toplevel) || exit 1
cd "$top" || exit 1
lines=$(mktemp) || exit 1
trap 'rm -f "$lines"' EXIT
cat > "$lines" || {
    echo "pre-push: the push lines cannot be stored, push refused" >&2
    exit 1
}
uv run --frozen python tests/test_public_hygiene.py || {
    echo "pre-push: public hygiene check failed, push refused" >&2
    exit 1
}
uv run --frozen python scripts/gitleaks_gate.py pre-push "$1" "$2" < "$lines" || {
    echo "pre-push: secret scan failed, push refused" >&2
    exit 1
}
