#!/bin/sh
# Secret scan over everything the push brings (content, merge results, messages, annotated tags),
# then the repository's own steps.
# The push lines on stdin are kept in a file because two commands read them.
top=$(git rev-parse --show-toplevel) || exit 1
cd "$top" || exit 1
py=python
command -v python >/dev/null 2>&1 || py=python3
lines=$(mktemp) || exit 1
trap 'rm -f "$lines"' EXIT
cat > "$lines" || {
    echo "pre-push: the push lines cannot be stored, push refused" >&2
    exit 1
}
"$py" scripts/gitleaks_gate.py pre-push "$1" "$2" < "$lines" || {
    echo "pre-push: secret scan failed, push refused" >&2
    exit 1
}
# The repository's own step runs here, after a clean scan (.githooks/after-scan/pre-push).
# A file .githooks/after-scan.required names each hook that must have such a step.
req=.githooks/after-scan.required
need=no
if [ -L "$req" ]; then
    echo "pre-push: .githooks/after-scan.required is not usable, push refused" >&2
    exit 1
fi
if [ -e "$req" ]; then
    if [ ! -f "$req" ]; then
        echo "pre-push: .githooks/after-scan.required is not usable, push refused" >&2
        exit 1
    fi
    size=$(LC_ALL=C wc -c < "$req" | tr -d ' ')
    other=$(LC_ALL=C tr -d 'a-z\n-' < "$req" | LC_ALL=C wc -c | tr -d ' ')
    ends=$(tail -c 1 "$req" | LC_ALL=C wc -l | tr -d ' ')
    if [ "$size" -lt 1 ] || [ "$size" -gt 64 ] || [ "$other" != 0 ] || [ "$ends" != 1 ]; then
        echo "pre-push: .githooks/after-scan.required is not usable, push refused" >&2
        exit 1
    fi
    seen=" "
    while IFS= read -r name; do
        case "$name" in
            pre-commit | commit-msg | pre-push) ;;
            *)
                echo "pre-push: .githooks/after-scan.required is not usable, push refused" >&2
                exit 1 ;;
        esac
        case "$seen" in
            *" $name "*)
                echo "pre-push: .githooks/after-scan.required is not usable, push refused" >&2
                exit 1 ;;
        esac
        seen="$seen$name "
        if [ "$name" = "pre-push" ]; then need=yes; fi
    done < "$req"
fi
step=.githooks/after-scan/pre-push
if [ -L .githooks/after-scan ] || [ -L "$step" ]; then
    echo "pre-push: the step in .githooks/after-scan is not usable, push refused" >&2
    exit 1
fi
if [ -e "$step" ]; then
    if [ ! -f "$step" ] || [ ! -x "$step" ]; then
        echo "pre-push: the step in .githooks/after-scan is not usable, push refused" >&2
        exit 1
    fi
    "$step" "$1" "$2" < "$lines" || {
        echo "pre-push: the step in .githooks/after-scan refused, push refused" >&2
        exit 1
    }
elif [ "$need" = yes ]; then
    echo "pre-push: the step required by .githooks/after-scan.required is missing, push refused" >&2
    exit 1
fi
